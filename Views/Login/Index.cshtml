@using MiWebAPI.ViewModels.LoginViewModel;
@model LoginViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<form asp-action="Login" method="post">
    <section class="form-group">
        <label asp-for="Username" class="control-label">Usuario:</label>
        <input asp-for="Username" type="text" class="form-control">
        <span asp-validation-for="Username" class="text-danger"></span>
    </section>
        <label asp-for="Password" class="control-label">Contrasenia:</label>
        <input asp-for="Password" type="text" class="form-control">
        <span asp-validation-for="Password" class="text-danger"></span>
    </section>
    <section class="form-group mt-2">
        <button type="submit" class="btn btn-primary">Iniciar sesion</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </section>
</form>

<partial name="_ValidationScriptsPartial" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} @* validacion del lado del cliente *@
}